# Variables de entorno requeridas en producción (Render)
DATABASE_URL=postgresql://usuario:clave@host:5432/totem_db
JWT_SECRET=            # cadena larga y aleatoria; sin ella las sesiones se pierden al reiniciar
JWT_HORAS=8
ALLOWED_ORIGINS=https://tu-dashboard.example.com   # separados por coma
TOTEM_API_KEY=         # misma clave que EXPO_PUBLIC_TOTEM_KEY en la app del tótem
ADMIN_USER=admin
ADMIN_PASSWORD=
ENCARGADO_USER=encargado
ENCARGADO_PASSWORD=

# Identificación de socios (gimnasio universitario)
VIGENCIA_HORAS=24                   # una evaluación más reciente que esto se considera vigente
MATRICULA_REGEX=^[A-Z0-9]{6,15}$    # formato de matrícula (sobre la matrícula normalizada)
MAX_CONSULTAS_IDENTIDAD=30          # consultas de identificación por IP cada 5 minutos

# Motor de aptitud / IA (opcionales)
# REGLAS_APTITUD_PATH=reglas_aptitud.json   # otro archivo de reglas (por defecto el que viene con el código)
# MODELO_IA_PATH=modelos/xgb-actual         # carpeta de un modelo entrenado con ia/entrenar.py (ver ia/README.md)

# Seguridad (interruptor). Apagado por defecto: SIN login, SIN clave del tótem y con CORS abierto, así que cualquiera con la URL
# puede leer y modificar evaluaciones (datos de salud). Para activarla en Render: SEGURIDAD_ACTIVA=true y definir
# JWT_SECRET, TOTEM_API_KEY y ALLOWED_ORIGINS. El dashboard detecta el modo solo (consulta /api/configuracion).
SEGURIDAD_ACTIVA=false
