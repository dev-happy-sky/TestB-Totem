# Variables públicas de la app del tótem (Expo las incrusta al compilar; no pongas secretos de usuarios aquí)
EXPO_PUBLIC_API_URL=https://totem-backend-g6yh.onrender.com
EXPO_PUBLIC_TOTEM_KEY=              # misma clave que TOTEM_API_KEY del backend
EXPO_PUBLIC_TOTEM_SERIAL=TOTEM-001  # identifica a este tótem
EXPO_PUBLIC_TOTEM_SUCURSAL=         # p. ej. "Campus San Joaquín"

# Sensores: "simulado" (todo simulado), "oximetro_puente" (oxímetro real vía puente-oximetro/) y/o "bascula_puente" (báscula real
# vía puente-bascula/). Se combinan con coma: oximetro_puente,bascula_puente. Lo que no tiene adaptador sigue simulado.
EXPO_PUBLIC_SENSORES=simulado
# EXPO_PUBLIC_PUENTE_OXIMETRO_URL=http://localhost:8765
# EXPO_PUBLIC_PUENTE_OXIMETRO_KEY=     # igual a PUENTE_TOKEN del puente, si lo definiste
# EXPO_PUBLIC_PUENTE_BASCULA_URL=http://localhost:8766
# EXPO_PUBLIC_PUENTE_BASCULA_KEY=      # igual a PUENTE_TOKEN del puente de la báscula, si lo definiste
EXPO_PUBLIC_SIMULAR_FALLAS=0        # probabilidad (0 a 1) de que una medición simulada falle, para probar el flujo de errores
