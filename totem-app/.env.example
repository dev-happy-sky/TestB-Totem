# Variables públicas de la app del tótem (Expo las incrusta al compilar; no pongas secretos de usuarios aquí)
EXPO_PUBLIC_API_URL=https://totem-backend-g6yh.onrender.com
EXPO_PUBLIC_TOTEM_KEY=              # misma clave que TOTEM_API_KEY del backend
EXPO_PUBLIC_TOTEM_SERIAL=TOTEM-001  # identifica a este tótem
EXPO_PUBLIC_TOTEM_SUCURSAL=         # p. ej. "Campus San Joaquín"

# Sensores: "simulado" (todo simulado), "oximetro_puente" (oxímetro real vía puente-oximetro/, el resto simulado)
# u "oximetro_web" (oxímetro por Bluetooth directo desde el navegador; solo en web: Chrome/Android o Bluefy/iPhone)
EXPO_PUBLIC_SENSORES=simulado
# EXPO_PUBLIC_PUENTE_OXIMETRO_URL=http://localhost:8765
# EXPO_PUBLIC_PUENTE_OXIMETRO_KEY=     # igual a PUENTE_TOKEN del puente, si lo definiste
# Solo en modo "oximetro_web" (Web Bluetooth). El servicio hay que confirmarlo en nRF Connect (el UUID justo
# encima de la característica ffe2); por defecto se prueba con ffe0.
# EXPO_PUBLIC_OXIMETRO_BLE_SERVICIO=0000ffe0-0000-1000-8000-00805f9b34fb
# EXPO_PUBLIC_OXIMETRO_BLE_NOTIFY=0000ffe2-0000-1000-8000-00805f9b34fb
# EXPO_PUBLIC_OXIMETRO_BLE_NOMBRE=     # prefijo del nombre del dispositivo para filtrar el selector (opcional)
EXPO_PUBLIC_SIMULAR_FALLAS=0        # probabilidad (0 a 1) de que una medición simulada falle, para probar el flujo de errores
